# Copy to .env for local development. On Netlify, set these under
# Project configuration → Environment variables.

# Postgres connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random strings. Generate with:  openssl rand -base64 32
SESSION_SECRET=
# Encrypts saved WhatsApp/Google/AI keys. Never change or lose it once set,
# or saved keys can't be read and must be entered again.
APP_ENCRYPTION_KEY=

# Address of the dashboard (used for webhook and invite links)
PUBLIC_URL=https://work.eedbe.com

# People must enter this code to sign up. Or set SIGNUPS_CLOSED=true (invites only).
SIGNUP_CODE=
# SIGNUPS_CLOSED=true

# Optional: AI for every workspace (console.anthropic.com). Workspaces can add their own instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
